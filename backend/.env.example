# Angel AI — конфигурация (положите как backend/.env или задайте env-переменные)

# --- Приложение ---
ANGEL_APP_NAME=Angel AI
ANGEL_APP_ENV=dev
ANGEL_LOG_LEVEL=INFO
ANGEL_DEFAULT_USER_USERNAME=angel

# --- База данных (по умолчанию SQLite; для production — PostgreSQL) ---
ANGEL_DATABASE_URL=postgresql+psycopg://angel:angel@localhost:5432/angel

# --- Telegram ---
ANGEL_TELEGRAM_BOT_TOKEN=
ANGEL_TELEGRAM_POLL_INTERVAL=2.0

# --- LLM (primary) ---
ANGEL_LLM_PROVIDER=local            # local | http
ANGEL_LLM_MODEL=qwen2.5:7b
ANGEL_LLM_API_URL=http://localhost:11434/v1
ANGEL_LLM_API_KEY=
ANGEL_LLM_TEMPERATURE=0.3
ANGEL_LLM_MAX_TOKENS=1024
ANGEL_LLM_TIMEOUT=60.0
ANGEL_LLM_MAX_STEPS=8

# --- LLM (fallback) ---
ANGEL_LLM_FALLBACK_PROVIDER=
ANGEL_LLM_FALLBACK_API_URL=
ANGEL_LLM_FALLBACK_API_KEY=
ANGEL_LLM_FALLBACK_MODEL=

# --- Markdown Vault ---
ANGEL_MARKDOWN_VAULT_PATH=../vault
ANGEL_MARKDOWN_ENABLED=true

# --- Workers ---
ANGEL_SCHEDULER_INTERVAL=5.0
ANGEL_WORKER_CONCURRENCY=2
ANGEL_WORKER_RETRY_ATTEMPTS=3

# --- Безопасность ---
ANGEL_CONFIRMATION_TTL_SECONDS=300

# --- CORS (для отдельного dev-фронтенда) ---
ANGEL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173